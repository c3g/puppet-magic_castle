CgroupMountpoint="/sys/fs/cgroup"
ConstrainCores=no
CgroupAutomount=no
<% if versioncmp($slurm_version, '22.05') < 0 { -%>
AllowedDevicesFile="/etc/slurm/cgroup_allowed_devices_file.conf"
<% } -%>
ConstrainCores=no
<% if $slurm_version == '20.11' { -%>
TaskAffinity=yes
<% } -%>
ConstrainSwapSpace=yes
ConstrainDevices=yes
AllowedRamSpace=100
AllowedSwapSpace=0
MaxRAMPercent=100
MaxSwapPercent=100
MinRAMSpace=1000
